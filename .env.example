# 複製成 .env 後依環境修改；.env 不進 git
# 主機上的腳本（ingest、eval、uvicorn）連資料庫用；預設指向 docker compose 的 db（對外 port 5433）
DATABASE_URL=postgresql://twse:twse@localhost:5433/twse
# pytest 的資料庫整合測試用；連不上會自動跳過
TEST_DATABASE_URL=postgresql://twse:twse@localhost:5433/twse_test

EMBED_PROVIDER=ollama
EMBED_MODEL=bge-m3
# 要跟模型輸出維度一致；換模型要重建 chunks 資料表
EMBED_DIM=1024
OLLAMA_BASE_URL=http://localhost:11434

# 後端（backend/）
LLM_MODEL=qwen3.5:2b
LLM_TEMPERATURE=0.1
TOP_K=8
# 最相近 chunk 的 cosine 距離超過此值就直接回答「年報中查無相關資料」，不呼叫 LLM。
# 0.33 是用 13 題實測暫訂（相關 0.19～0.31、資料庫外公司 0.35～0.52），評估階段（eval/）要重新校準
NO_ANSWER_DISTANCE=0.33
# 問題提到資料庫裡的公司（含別名）時改用這個較寬的門檻；評估見 eval/results.md
NO_ANSWER_DISTANCE_WITH_COMPANY=0.5
# LLM 最大輸出 token 數與每次 /ask 的整體時間上限；超過時回答結尾加「（回答過長，已截斷）」
LLM_MAX_TOKENS=1024
ASK_TIMEOUT_SECONDS=60

# --- docker compose ---
# db 容器的帳密；backend 容器的 DATABASE_URL 會用這三個值自動組成（指向 db 服務）
POSTGRES_USER=twse
POSTGRES_PASSWORD=twse
POSTGRES_DB=twse
# 容器連主機上 Ollama 的位址（上面的 OLLAMA_BASE_URL 是給 venv 直接執行用的）
DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434
FRONTEND_PORT=8080
BACKEND_PORT=8000
DB_PORT=5433
