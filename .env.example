# 複製成 .env 後依環境修改；.env 不進 git
DATABASE_URL=postgresql://twse:twse@localhost:5432/twse
# pytest 的資料庫整合測試用；連不上會自動跳過
TEST_DATABASE_URL=postgresql://twse:twse@localhost:5432/twse_test

EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
# 要跟模型輸出維度一致；換模型要重建 chunks 資料表
EMBEDDING_DIM=1024
OLLAMA_URL=http://localhost:11434
